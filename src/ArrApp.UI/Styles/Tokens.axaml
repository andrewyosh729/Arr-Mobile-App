<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors that change with the theme variant. Look these up with DynamicResource. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0E1116"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#171B22"/>
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1F252E"/>
            <SolidColorBrush x:Key="BorderBrushSubtle" Color="#2A313C"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F4F7"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AA4B2"/>
            <SolidColorBrush x:Key="ScrimBrush" Color="#99000000"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#F0616D"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="#3DD68C"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#F5B841"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F6F7F9"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#EEF1F5"/>
            <SolidColorBrush x:Key="BorderBrushSubtle" Color="#D8DEE6"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5B6675"/>
            <SolidColorBrush x:Key="ScrimBrush" Color="#66000000"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#C8323F"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="#16995C"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#B7791F"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Accent defaults; replaced at runtime per active Arr by ThemeManager.ApplyAccent. -->
    <Color x:Key="AccentColor">#6C8CFF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#0B0F14"/>

    <!-- Spacing scale -->
    <x:Double x:Key="SpaceXs">4</x:Double>
    <x:Double x:Key="SpaceSm">8</x:Double>
    <x:Double x:Key="SpaceMd">12</x:Double>
    <x:Double x:Key="SpaceLg">16</x:Double>
    <x:Double x:Key="SpaceXl">24</x:Double>
    <Thickness x:Key="PagePadding">16</Thickness>

    <!-- Shape -->
    <CornerRadius x:Key="RadiusSm">8</CornerRadius>
    <CornerRadius x:Key="RadiusMd">12</CornerRadius>
    <CornerRadius x:Key="RadiusPill">22</CornerRadius>
    <CornerRadius x:Key="RadiusSheet">16,16,0,0</CornerRadius>

    <!-- Touch -->
    <x:Double x:Key="MinTouchTarget">44</x:Double>

    <!-- Type scale -->
    <x:Double x:Key="FontSizeCaption">12</x:Double>
    <x:Double x:Key="FontSizeBody">15</x:Double>
    <x:Double x:Key="FontSizeSubtitle">17</x:Double>
    <x:Double x:Key="FontSizeTitle">22</x:Double>
    <x:Double x:Key="FontSizeHeadline">28</x:Double>
</ResourceDictionary>
