<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ArrApp.UI.ViewModels"
             x:Class="ArrApp.UI.Views.TabHostView"
             x:DataType="vm:TabHostViewModel">
    <DockPanel>
        <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Tabs}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TabItem">
                    <Button Content="{Binding Title}" MinHeight="48"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding $parent[UserControl].((vm:TabHostViewModel)DataContext).SelectTabCommand}"
                            CommandParameter="{Binding}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ContentControl Content="{Binding SelectedTab.Content}"/>
    </DockPanel>
</UserControl>
