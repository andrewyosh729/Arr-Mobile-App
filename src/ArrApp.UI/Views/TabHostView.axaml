<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ArrApp.UI.ViewModels"
             x:Class="ArrApp.UI.Views.TabHostView"
             x:DataType="vm:TabHostViewModel">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="tabbar">
            <ItemsControl ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TabItem">
                        <Button Classes="tab" Classes.selected="{Binding IsSelected}"
                                Content="{Binding Title}"
                                HorizontalAlignment="Stretch"
                                Command="{Binding $parent[UserControl].((vm:TabHostViewModel)DataContext).SelectTabCommand}"
                                CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <ContentControl Content="{Binding SelectedTab.Content}"/>
    </DockPanel>
</UserControl>
