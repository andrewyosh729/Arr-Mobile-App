<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ArrApp.UI.ViewModels"
             xmlns:controls="using:ArrApp.UI.Controls"
             x:Class="ArrApp.UI.Views.PlaceholderView"
             x:DataType="vm:PlaceholderViewModel">
    <ScrollViewer>
        <StackPanel Spacing="12" Margin="{StaticResource PagePadding}" VerticalAlignment="Center">
            <TextBlock Classes="title" Text="{Binding Title}" HorizontalAlignment="Center"/>
            <TextBlock Classes="caption" Text="{Binding Context.ActiveLabel}" HorizontalAlignment="Center"/>
            <TextBlock Classes="caption" Text="{Binding Context.MediaNoun, StringFormat=Browsing your {0}}" HorizontalAlignment="Center"/>
            <Button Content="Load library (dev)" Command="{Binding LoadLibraryDevCommand}" HorizontalAlignment="Center"/>

            <!-- TEMP: the real media card in both layouts, until the library screen (F-301/F-302) -->
            <ItemsControl ItemsSource="{Binding DevCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" ColumnSpacing="10"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MediaCardViewModel">
                        <controls:MediaCard Layout="Grid"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding DevCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MediaCardViewModel">
                        <controls:MediaCard Layout="List"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Classes="primary" Content="Open detail" Command="{Binding OpenDetailCommand}" HorizontalAlignment="Center"/>
            <Button Content="Show sheet" Command="{Binding ShowSheetCommand}" HorizontalAlignment="Center"/>
            <Button Content="Test key vault" Command="{Binding TestKeyVaultCommand}" HorizontalAlignment="Center"/>
            <Button Classes="danger" Content="Throw test error" Command="{Binding ThrowTestErrorCommand}" HorizontalAlignment="Center"/>
            <Button Content="Back" Command="{Binding BackCommand}" IsVisible="{Binding CanGoBack}" HorizontalAlignment="Center"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
