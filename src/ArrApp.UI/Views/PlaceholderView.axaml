<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ArrApp.UI.ViewModels"
             x:Class="ArrApp.UI.Views.PlaceholderView"
             x:DataType="vm:PlaceholderViewModel">
    <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Classes="title" Text="{Binding Title}" HorizontalAlignment="Center"/>
        <Button Classes="primary" Content="Open detail" Command="{Binding OpenDetailCommand}" HorizontalAlignment="Center"/>
        <Button Content="Show sheet" Command="{Binding ShowSheetCommand}" HorizontalAlignment="Center"/>
        <Button Classes="danger" Content="Throw test error" Command="{Binding ThrowTestErrorCommand}" HorizontalAlignment="Center"/>
        <Button Content="Back" Command="{Binding BackCommand}" IsVisible="{Binding CanGoBack}" HorizontalAlignment="Center"/>
    </StackPanel>
</UserControl>
