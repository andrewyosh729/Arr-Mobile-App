<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ArrApp.UI.ViewModels"
             xmlns:controls="using:ArrApp.UI.Controls"
             x:Class="ArrApp.UI.Views.MediaCollectionView"
             x:DataType="vm:MediaCollectionViewModel">
    <DockPanel>
        <!-- Header: what this is, the refresh button (for mouse users; touch users pull down) and the layout toggle -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="16,8,12,4">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Classes="headline" Text="{Binding Title}"/>
                <TextBlock Classes="caption" Text="{Binding TotalCount}" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="chip" Content="⟳" Margin="0,0,8,0"
                    Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh"/>
            <Button Grid.Column="2" Classes="chip" Content="{Binding LayoutToggleText}" Command="{Binding ToggleLayoutCommand}"/>
        </Grid>

        <!-- Search, sort and filters: only once there is a library to work on -->
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="16,4,16,8" IsVisible="{Binding HasItems}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding SearchText}" PlaceholderText="{Binding SearchPlaceholder}">
                    <TextBox.InnerRightContent>
                        <Button Classes="chip" Content="✕" MinWidth="36" Padding="8,0" Margin="0,0,4,0"
                                IsVisible="{Binding HasSearchText}" Command="{Binding ClearFiltersCommand}"/>
                    </TextBox.InnerRightContent>
                </TextBox>
                <Button Grid.Column="1" Classes="chip" Content="{Binding SortChipText}" Command="{Binding ShowSortCommand}"/>
            </Grid>

            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding FilterChips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FilterChipViewModel">
                            <Button Classes="chip" Classes.selected="{Binding IsSelected}" Content="{Binding Text}"
                                    Command="{Binding $parent[UserControl].((vm:MediaCollectionViewModel)DataContext).SetFilterCommand}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <Panel>
            <!-- First load -->
            <StackPanel IsVisible="{Binding IsLoading}" VerticalAlignment="Center" Spacing="12" Margin="32">
                <ProgressBar IsIndeterminate="True" MaxWidth="200"/>
                <TextBlock Classes="caption" Text="Loading your library…" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- The load failed -->
            <StackPanel IsVisible="{Binding HasError}" VerticalAlignment="Center" Spacing="12" Margin="32">
                <TextBlock Classes="title" Text="Couldn't load your library" HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Button Classes="primary" Content="Try again" HorizontalAlignment="Center" Command="{Binding RetryCommand}"/>
            </StackPanel>

            <!-- Connected, but nothing in the library -->
            <StackPanel IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" Spacing="8" Margin="32">
                <TextBlock Classes="title" Text="Nothing here yet" HorizontalAlignment="Center"/>
                <TextBlock Classes="caption" Text="Anything you add on this server will show up here."
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- The library: pull down to refresh; only the rows on screen exist as controls -->
            <RefreshContainer x:Name="Refresher" IsVisible="{Binding ShowContent}" RefreshRequested="OnRefreshRequested">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.DataTemplates>
                            <DataTemplate DataType="vm:GridRowViewModel" x:DataType="vm:GridRowViewModel">
                                <ItemsControl ItemsSource="{Binding Cells}" Margin="16,0,16,14">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" ColumnSpacing="10"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MediaCellViewModel">
                                            <Border IsVisible="{Binding HasCard}">
                                                <controls:MediaCard Layout="Grid" DataContext="{Binding Card}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                            <DataTemplate DataType="vm:ListRowViewModel" x:DataType="vm:ListRowViewModel">
                                <controls:MediaCard Layout="List" DataContext="{Binding Card}" Margin="16,0,16,8"/>
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>
                </ScrollViewer>
            </RefreshContainer>

            <!-- The library has items, but the search/filter keeps none -->
            <StackPanel IsVisible="{Binding NoMatches}" VerticalAlignment="Center" Spacing="12" Margin="32">
                <TextBlock Classes="title" Text="Nothing matches" HorizontalAlignment="Center"/>
                <TextBlock Classes="caption" Text="Try a different search or filter." HorizontalAlignment="Center"/>
                <Button Content="Clear filters" HorizontalAlignment="Center" Command="{Binding ClearFiltersCommand}"/>
            </StackPanel>
        </Panel>
    </DockPanel>
</UserControl>
