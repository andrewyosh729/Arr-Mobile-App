<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ArrApp.UI.ViewModels"
             x:Class="ArrApp.UI.Views.ServersView"
             x:DataType="vm:ServersViewModel">
    <DockPanel>
        <!-- Header -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="8,8,8,0">
            <Button Grid.Column="0" Content="‹ Back" Classes="chip" Command="{Binding BackCommand}"/>
            <TextBlock Grid.Column="1" Classes="title" Text="Servers"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Button Grid.Column="2" Content="+ Add" Classes="primary" Command="{Binding AddCommand}"/>
        </Grid>

        <ScrollViewer>
            <StackPanel Spacing="12" Margin="{StaticResource PagePadding}">

                <!-- Empty state -->
                <StackPanel IsVisible="{Binding IsEmpty}" Spacing="12" Margin="0,48,0,0">
                    <TextBlock Classes="title" Text="No servers yet" HorizontalAlignment="Center"/>
                    <TextBlock Classes="caption" Text="Add your Sonarr or Radarr server to get started."
                               HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    <Button Classes="primary" Content="Add a server" Command="{Binding AddCommand}"
                            HorizontalAlignment="Center"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="12"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServerItemViewModel">
                            <Border Classes="card">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <!-- Type badge in the Arr's accent colour -->
                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                                                Background="{Binding AccentBrush}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="20"
                                                       Foreground="{DynamicResource OnAccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Classes="subtitle" Text="{Binding Name}"/>
                                                <Border Classes="pill" IsVisible="{Binding IsDefault}">
                                                    <TextBlock Classes="caption" Text="Default"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Classes="caption" Text="{Binding Url}" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Classes="dot" Classes.online="{Binding IsOnline}"
                                                           Classes.offline="{Binding IsOffline}" Text="●"/>
                                                <TextBlock Classes="caption" Text="{Binding StatusText}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <WrapPanel>
                                        <Button Classes="chip" Content="Edit" Margin="0,0,8,8"
                                                Command="{Binding $parent[UserControl].((vm:ServersViewModel)DataContext).EditCommand}"
                                                CommandParameter="{Binding}"/>
                                        <Button Classes="chip" Content="Make default" Margin="0,0,8,8"
                                                IsVisible="{Binding IsNotDefault}"
                                                Command="{Binding $parent[UserControl].((vm:ServersViewModel)DataContext).SetDefaultCommand}"
                                                CommandParameter="{Binding}"/>
                                        <Button Classes="chip" Content="↑" Margin="0,0,8,8"
                                                IsEnabled="{Binding CanMoveUp}"
                                                Command="{Binding $parent[UserControl].((vm:ServersViewModel)DataContext).MoveUpCommand}"
                                                CommandParameter="{Binding}"/>
                                        <Button Classes="chip" Content="↓" Margin="0,0,8,8"
                                                IsEnabled="{Binding CanMoveDown}"
                                                Command="{Binding $parent[UserControl].((vm:ServersViewModel)DataContext).MoveDownCommand}"
                                                CommandParameter="{Binding}"/>
                                        <Button Classes="chip danger" Content="Delete" Margin="0,0,0,8"
                                                Command="{Binding $parent[UserControl].((vm:ServersViewModel)DataContext).DeleteCommand}"
                                                CommandParameter="{Binding}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="Refresh status" Classes="chip" HorizontalAlignment="Center"
                        Command="{Binding RefreshCommand}" IsVisible="{Binding !IsEmpty}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
