<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ArrApp.UI.ViewModels"
             x:Class="ArrApp.UI.Views.ShellView"
             x:DataType="vm:ShellViewModel"
             Background="{DynamicResource AppBackgroundBrush}"
             Focusable="True">
    <Grid>
        <ContentControl Content="{Binding Navigation.Current}"/>

        <!-- Scrim + bottom sheet -->
        <Grid IsVisible="{Binding Sheets.IsOpen}">
            <Border Background="{DynamicResource ScrimBrush}" PointerPressed="OnScrimPressed"/>
            <Border VerticalAlignment="Bottom" MinHeight="200"
                    CornerRadius="{StaticResource RadiusSheet}" Padding="{StaticResource PagePadding}"
                    Background="{DynamicResource SurfaceBrush}">
                <ContentControl Content="{Binding Sheets.Current}"/>
            </Border>
        </Grid>

        <!-- Toast / snackbar, sits above the tab bar. Tap to dismiss. -->
        <Border Classes="toast" IsVisible="{Binding Toasts.Current, Converter={x:Static ObjectConverters.IsNotNull}}"
                Classes.error="{Binding Toasts.Current.IsError}"
                Classes.success="{Binding Toasts.Current.IsSuccess}"
                VerticalAlignment="Bottom" Margin="16,0,16,72"
                PointerPressed="OnToastPressed">
            <TextBlock Text="{Binding Toasts.Current.Message}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
