<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ArrApp.UI.ViewModels"
             x:Class="ArrApp.UI.Views.ShellView"
             x:DataType="vm:ShellViewModel"
             Focusable="True">
    <Grid>
        <ContentControl Content="{Binding Navigation.Current}"/>

        <!-- Scrim + bottom sheet -->
        <Grid IsVisible="{Binding Sheets.IsOpen}">
            <Border Background="#99000000" PointerPressed="OnScrimPressed"/>
            <Border VerticalAlignment="Bottom" MinHeight="200"
                    CornerRadius="16,16,0,0" Padding="16"
                    Background="{DynamicResource SystemRegionColor}">
                <ContentControl Content="{Binding Sheets.Current}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
